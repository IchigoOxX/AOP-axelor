<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_6.1.xsd">

    <module name="poultryfarming" package="com.gl.apps.pf.db"/>

    <entity name="DashRepro">
        <one-to-many name="reproductionDashboardList" ref="com.gl.apps.pf.db.DashboardRepro" title="List"/>

        <track on="UPDATE">
            <field name="reproductionDashboardList"/>
            <field name="testList"/>
            <message if="true" on="UPDATE">Record updated</message>
        </track>

    </entity>

</domain-models>