<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_6.1.xsd">

    <module name="poultryfarming" package="com.gl.apps.pf.db"/>

    <entity name="HatcheryEggsReception">

        <one-to-many name="hatcheryEggsReceptionLineList"
                     ref="com.gl.apps.pf.db.HatcheryEggsReceptionLine" mappedBy="eggsReception"
                     title="Hatchery Eggs Reception Line"/>

        <string name="reference" title="Reference" readonly="true" unique="true"/>
        <date name="dateTime" title="Date Time" required="true"/>
        <many-to-one name="breed" ref="Breed" title="Breed" required="true"/>
        <many-to-one name="trackingNumber" ref="com.axelor.apps.stock.db.TrackingNumber"
                     title="Tracking Number" required="true"/>
        <many-to-one name="unit" ref="com.axelor.apps.base.db.CompanyDepartment"
                     title="Unit (Department)" required="true"/>
        <many-to-one name="center" ref="Center" title="Center" required="true"/>
        <many-to-one name="hatchery" ref="Hatchery" title="Hatchery"/>

        <integer name="weeklyAge" title="Weekly age" readonly="true">
            <![CDATA[
            int weeklyAge = (int) Math.ceil(this.getDailyAge() / 7) + 1;
             return (this.getDailyAge() % 7 == 0) ? weeklyAge - 1 : weeklyAge;
        ]]>
        </integer>
        <integer name="dailyAge" title="Daily age" required="true"/>

        <time name="deliveryTime" title="Delivery time"/>
        <time name="arrivalTime" title="Arrival time"/>
        <!--    adding fields-->
        <decimal name="sendingTemperature" title="Sending Temperature"/>
        <many-to-one name="carrierPartner" ref="com.axelor.apps.base.db.Partner" title="Carrier"/>
        <string name="carrierDriver" title="Driver"/>

        <integer name="status" title="Status"
                 selection="poultryfarming.eggs.reception.status.select" readonly="true"/>

        <integer name="referenceOfOrigin" title="Reference of origin"/>
        <date name="dateOfOrigin" title="Date of origin" readonly="true"/>
        <integer name="typeOfOrigin" title="Type of origin"
                 selection="poultryfarming.eggs.type.origin.select"/>
        <many-to-one name="unitOfOrigin" ref="com.axelor.apps.base.db.CompanyDepartment"
                     title="Unit of origin"/>
        <many-to-one name="reproProduction" ref="ReproProduction" title="Repro production"/>

        <many-to-one name="stockMove" ref="com.axelor.apps.stock.db.StockMove"
                     title="Stock move"/>

        <integer name="sumNumberOfHeTrays" title="SUM Number Of He Trays" readonly="true">
            <![CDATA[
          return this.getHatcheryEggsReceptionLineList() != null ? this.getHatcheryEggsReceptionLineList().stream().mapToInt(x-> x.getNumberOfHeTrays()).sum() : 0 ;
           ]]>
        </integer>

