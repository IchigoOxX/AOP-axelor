<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_6.1.xsd">

    <module name="poultryfarming" package="com.gl.apps.pf.db"/>

    <entity name="FleshMovementLine" >
        <many-to-one name="fleshMovement"
                     ref="com.gl.apps.pf.db.FleshMovement" title="Flesh movement"/>

        <many-to-one name="toBreedingShed"
                     ref="com.gl.apps.pf.db.BreedingShed" title="Breeding Shed" required="true"/>
        <integer name="lineNumber" title="Line Number" required="true"/>
        <integer name="toTransferChicksNumber" title="Transferred chicks" />
        <integer name="currentChicksNumber" title="Current chicks number" />

        <track on="UPDATE">
            <field name="fleshTransfer"/>
            <field name="toBreedingShed"/>
            <field name="lineNumber"/>
            <field name="toTransferChicksNumber"/>
            <field name="currentChicksNumber"/>

            <message if="true" on="UPDATE">Record updated</message>
        </track>
    </entity>

</domain-models>