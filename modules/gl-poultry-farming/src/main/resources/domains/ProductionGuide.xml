<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_6.1.xsd">

  <module name="poultryfarming" package="com.gl.apps.pf.db"/>

  <entity name="ProductionGuide" >
    <many-to-one name="breed" ref="Breed" title="Breed" initParam="true" />
    <integer name="ageInDays" title="Age in days" required="false"/>
    <integer name="ageInWeeks" title="Age in weeks" readonly="false">
      <![CDATA[
         if(this.getAgeInDays() % 7 == 0 ) {
            return this.getAgeInDays() / 7 ;
          }
          return null;
       ]]>
    </integer>
    <integer name="dayNumber" title="Day number" required="true"/>
    <integer name="weekNumber" title="Week number" readonly="true">
      <![CDATA[
         if(this.getDayNumber() % 7 == 0 ) {
            return this.getDayNumber() / 7 ;
          }
          return null;
       ]]>
    </integer>
    <decimal name="hatchingRate" title="Hatching rate"/>
    <decimal name="weeklyEggsQuantity" title="Weekly eggs quantity"/>
    <decimal name="incubateEggsNumber" title="Incubate eggs number"/>
    <decimal name="unitQtyEggsAtStartup" title="Unit qty eggs at startup"/>
    <decimal name="eggsQtyByFemalePresent" title="Eggs qty by female present"/>
    <decimal name="hatchingEggsRate" title="Hatching eggs rate"/>
    <decimal name="eggWeight" title="Egg weight"/>
    <decimal name="eggMass" title="Egg mass"/>

    <track on="UPDATE">

      <field name="breed"/>
      <field name="dailyAge"/>
      <field name="weeklyAge"/>
      <field name="dayNumber"/>
      <field name="weekNumber"/>
      <field name="hatchingRate"/>
      <field name="weeklyEggsQuantity"/>
      <field name="incubateEggsNumber"/>
      <field name="unitQtyEggsAtStartup"/>
      <field name="eggsQtyByFemalePresent"/>
      <field name="hatchingEggsRate"/>
      <field name="eggWeight"/>
      <field name="eggMass"/>


      <message if="true" on="UPDATE">Record updated</message>
    </track>


  </entity>



</domain-models>