<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_6.1.xsd">

  <module name="poultryfarming" package="com.gl.apps.pf.db"/>

  <entity name="HatcherTrolley">
    <many-to-one name="hatchery" ref="Hatchery" title="Hatchery" readonly="true"/>
    <many-to-one name="hatcher" ref="Hatcher" title="Hatcher" readonly="true"/>

    <string name="reference" title="Reference" readonly="true"/>
    <integer name="quantity" title="Quantity" readonly="true"/>
    <datetime name="entryDate" title="Entry date" readonly="true"/>
    <integer name="status" title="Status"
      selection="poultryfarming.hatcher.trolley.status.select" readonly="true"/>
    <integer name="capacityOfACartInBaskets" title="Capacity of a cart in baskets"/>

    <string name="note" title="Note" large="true" translatable="true"/>
    <index columns="hatchery,reference" unique="true"/>

    <finder-method name="ByReference" using="hatchery,reference"/>

    <extra-code>
      <![CDATA[
				public static final int STATUS_FREE = 0;
				public static final int STATUS_BUSY = 1;
				public static final int STATUS_RESERVED = 2;
                public static final int STATUS_IN_THE_INCUBATOR = 3;
                public static final int STATUS_IN_THE_HATCHER = 4;
				public static final int STATUS_STOPPED = 5;
			]]>
    </extra-code>

    <track on="UPDATE">
      <field name="reference"/>
      <field name="status"/>
      <field name="hatchery"/>
      <field name="incubator"/>
      <field name="hatcher"/>
      <field name="quantity"/>
      <field name="entryDate"/>
      <field name="note"/>
      <message if="true" on="UPDATE">Record updated</message>
    </track>
  </entity>

</domain-models>