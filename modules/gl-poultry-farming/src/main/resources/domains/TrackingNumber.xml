<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_6.1.xsd">

  <module name="stock" package="com.axelor.apps.stock.db"/>

  <entity name="TrackingNumber" >
    <one-to-many name="principalBatchNumberList"
      ref="com.gl.apps.pf.db.BreedingShed" title="Principal batch number"
      mappedBy="principalBatchNumber"/>

    <one-to-many name="currentBatchNumberList"
      ref="com.gl.apps.pf.db.BreedingShed" title="Current batch number"
      mappedBy="currentBatchNumber"/>

    <track on="UPDATE">
      <field name="principalBatchNumberList"/>
      <field name="currentBatchNumberList"/>
      <message if="true" on="UPDATE">Record updated</message>
    </track>


  </entity>

</domain-models>
