<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_6.1.xsd">

    <module name="poultryfarming" package="com.gl.apps.pf.db"/>

    <entity name="HatcheryDashboard">

        <string name="reference" title="Reference" required="true" unique="true"/>
        <many-to-one name="dashHatchery"
                     ref="com.gl.apps.pf.db.DashHatchery" title="Dashboard" />

        <string name="completeRefTrackingNumber" title="Complete tracking number" readonly="true"/>
        <many-to-one name="saleOrder" title="Sale order"
                     ref="com.axelor.apps.sale.db.SaleOrder"/>
        <integer name="internNumber" title="Intern"/>
        <integer name="externNumber" title="Extern"/>
        <integer name="remainingNumberOrder" title="Remaining"/>

        <integer name="commercial" title="Commercial"/>
        <many-to-one name="hatchery" ref="Hatchery" title="Hatchery"/>
        <integer name="remainingNumberDelivery" title="Remaining"/>


        <string name="lineNumber" title="Line Number" readonly="true"/>
        <datetime name="incubationDatetime" required="true" title="Incubation date and time"/>
        <datetime name="transferDatetime" required="true" title="Transfer date and time"/>
        <datetime name="hatchingDatetime" required="true" title="Hatching date and time"/>
        <string name="completeReference" title="Reference" readonly="true"/>
        <integer name="estimatedNumberOfChicks" title="Estimated number of chicks"/>
        <integer name="status" title="Status"
                 selection="poultryfarming.loading.program.line.status.select" readonly="true"/>


        <many-to-one name="incubator" ref="Incubator" title="Incubator"/>
        <string name="refIncubator" title="Incubator" readonly="true"/>

        <many-to-one name="incubatorEntry"
                     ref="com.gl.apps.pf.db.IncubatorEntry" title="Incubator entry"/>
        <string name="refIncubatorEntry" title="Incubator entry" readonly="true"/>
        <datetime name="datetimeIncubatorEntry" title="Date"/>
        <datetime name="dateTimeReelIncubatorExit" title="Date time"/>
        <many-to-one name="programLine"
                     ref="com.gl.apps.pf.db.IncubatorsLoadingProgramLine" title="Incubator program line"/>



        <many-to-one name="incubatorExit"
                     ref="com.gl.apps.pf.db.IncubatorExit" title="Incubator exit"/>
        <string name="refIncubatorExit" title="Incubator exit" readonly="true"/>
        <datetime name="datetimeIncubatorExit" title="Date"/>

        <many-to-one name="hatcherEntry" ref="com.gl.apps.pf.db.HatcherEntry"
                     title="Hatcher entry"/>
        <string name="refHatcherEntry" title="Hatcher entry" readonly="true"/>
        <datetime name="datetimeHatcherEntry" title="Date"/>


        <many-to-one name="hatcherExit" ref="com.gl.apps.pf.db.HatcherExit"
                     title="Hatcher exit"/>
        <string name="refHatcherExit" title="Hatcher exit" readonly="true"/>
        <datetime name="datetimeHatcherExit" title="Date"/>
        <integer name="safe" title="Safe"/>
        <decimal name="successRate" title="Success rate"/>

        <finder-method name="ByReference" using="reference"/>


        <track on="UPDATE">
            <field name="reference"/>
            <field name="completeRefTrackingNumber"/>
            <field name="saleOrder"/>
            <field name="internNumber"/>
            <field name="externNumber"/>
            <field name="remainingNumberOrder"/>
            <field name="commercial"/>
            <field name="hatchery"/>
            <field name="remainingNumberDelivery"/>
            <field name="lineNumber"/>
            <field name="incubationDatetime"/>
            <field name="transferDatetime"/>
            <field name="hatchingDatetime"/>
            <field name="completeReference"/>
            <field name="estimatedNumberOfChicks"/>
            <field name="status"/>
            <field name="incubator"/>
            <field name="incubatorEntry"/>
            <field name="datetimeIncubatorEntry"/>
            <field name="dateTimeProgramLine"/>
            <field name="incubatorExit"/>
            <field name="datetimeIncubatorExit"/>
            <field name="hatcherEntry"/>
            <field name="datetimeHatcherEntry"/>
            <field name="hatcherExit"/>
            <field name="datetimeHatcherExit"/>
            <field name="safe"/>
            <field name="successRate"/>

            <message if="true" on="UPDATE">Record updated</message>
        </track>

    </entity>

</domain-models>