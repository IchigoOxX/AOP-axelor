<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_6.1.xsd">

    <module name="poultryfarming" package="com.gl.apps.pf.db"/>

    <entity name="ReceptionReproProduction">

        <many-to-one name="dispatchStock" ref="com.axelor.apps.stock.db.StockMove"
                     title="Dispatch Stock"/>

        <many-to-one name="fromCenter" ref="com.gl.apps.pf.db.Center"
                     title="Center"/>
        <string name="fromBreedingShed" title="From breeding Shed" />
        <many-to-one name="breed" ref="Breed" title="Breed"/>
        <many-to-one name="trackingNumber" ref="com.axelor.apps.stock.db.TrackingNumber"
                     title="Tracking Number"/>
        <many-to-one name="elevTransfer" ref="ElevTransfer" title="Elev transfer" />
        <many-to-one name="center" ref="com.gl.apps.pf.db.Center"
                     title="Center"/>
        <many-to-one name="breedingShed" ref="com.gl.apps.pf.db.BreedingShed" title="To breeding Shed" />

        <string name="gender" title="Gender"
                selection="poultryfarming.breeding.transfer.gender.select"/>

        <string name="reference" title="Reference" unique="true" readonly="true"/>
        <date name="dateTime" title="Date Time"/>
        <date name="dateElevTransfer" title="Date" readonly="true"/>
        <integer name="receivedNumber" title="Received number"/>
        <integer name="gapNumber" title="Gap"/>
        <many-to-one name="stockCorrectionReason"
                     ref="com.axelor.apps.stock.db.StockCorrectionReason" title="Reason"/>
        <integer name="toTransferChickensNumber" title="To Transfer" required="true"/>
        <decimal name="globalCost" title="Global cost"/>
        <decimal name="averageCost" title="Average cost"/>
        <decimal name="weight" title="Weight"/>
        <integer name="dailyAge" title="Daily age"/>
        <integer name="weeklyAge" title="Weekly age" readonly="true">
            <![CDATA[
             int weeklyAge = (int) Math.ceil(this.getDailyAge() / 7) + 1;
             return (this.getDailyAge() % 7 == 0) ? weeklyAge - 1 : weeklyAge;
        ]]>
        </integer>
        <integer name="status" title="Status"
                 selection="poultryfarming.elev.transfer.status.select" readonly="true"/>
        <finder-method name="ByReference" using="reference"/>

        <extra-code>
            <![CDATA[
				// REPRO PRODUCTION STATUS SELECT
			    public static final int STATUS_NOT_RECEIVED = 0;
				public static final int STATUS_EXECUTING = 1;
				public static final int STATUS_RECEIVED = 2;
				public static final int STATUS_CANCELED = 3;

			]]>
        </extra-code>

        <track on="UPDATE">
            <field name="reference"/>
            <field name="dateTime"/>
            <field name="fromUnit"/>
            <field name="fromCenter"/>
            <field name="breed"/>
            <field name="trackingNumber"/>
            <field name="dispatchStock"/>
            <field name="unit"/>
            <field name="center"/>
            <field name="breedingShed"/>
            <field name="gender"/>
            <field name="elevTransfer"/>
            <field name="dateElevTransfer"/>
            <field name="receivedNumber"/>
            <field name="dailyAge"/>
            <field name="weeklyAge"/>
            <field name="status"/>
            <message if="true" on="UPDATE">Record updated</message>
        </track>


    </entity>

</domain-models>