<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_6.1.xsd">

    <module name="poultryfarming" package="com.gl.apps.pf.db"/>

    <entity name="ProductAttachmentType">

        <string name="title" title="Title"/>
        <boolean name="isRequired" title="Required"/>
        <many-to-one name="product" ref="com.axelor.apps.base.db.Product"
                     title="Product"/>
        <string name="note" title="Note" large="true" translatable="true"/>

        <track on="UPDATE">
            <field name="title"/>
            <field name="isRequired"/>
            <field name="note"/>
            <message if="true" on="UPDATE">Record updated</message>
        </track>


    </entity>

</domain-models>