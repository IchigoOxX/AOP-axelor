<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_6.1.xsd">

<module name="poultryfarming" package="com.gl.apps.pf.db"/>

  <entity name="HatcherEntry" >

    <one-to-many name="hatcherEntryLinesList" ref="HatcherEntryLine"
                 mappedBy="hatcherEntry" title="Hatcher entry lines" orderBy="lineNumber"/>

    <many-to-one name="incubatorExit" ref="IncubatorExit" title="Incubator exit"/>
    <many-to-one name="incubatorEntry" ref="IncubatorEntry" title="Incubator entry"/>
    <many-to-one name="incubator" ref="Incubator" title="Incubator"/>
    <many-to-one name="reasonOfCancel" title="Reason of incubator entry cancel"
                 ref="com.axelor.apps.base.db.CancelReason"/>
    <many-to-one name="dispatchStock" ref="com.axelor.apps.stock.db.StockMove"
                 title="Dispatch Stock"/>

    <datetime name="dateTimeIncubatorExit" title="Date time"/>
    <datetime name="dateTimeIncubatorEntry" title="Date time"/>
    <datetime name="dateTimeIncubatorExitEntry" title="Date time"/>

    <many-to-one name="unit" ref="com.axelor.apps.base.db.CompanyDepartment"
      title="Unit (Department)" readonly="true"/>
    <many-to-one name="hatchery" ref="Hatchery" title="Hatchery" readonly="true"/>
    <many-to-one name="canceledBy" ref="com.axelor.auth.db.User" title="Canceled by"
      readonly="true"/>
    <many-to-one name="breed" ref="Breed" title="Breed" />

    <string name="reference" title="Reference" readonly="true" unique="true"/>
    <datetime name="dateTime" title="Date" required="true"/>
    <time name="deliveryTime" title="Delivery time"/>
    <time name="arrivalTime" title="Arrival time"/>

    <datetime name="cancelDate" title="Cancel date"/>
    <integer name="status" title="Status"
      selection="poultryfarming.hatcher.entries.status.select" readonly="true"/>
    <string name="note" title="Note" large="true" translatable="true"/>
    <finder-method name="ByReference" using="reference"/>

    <extra-code>
			<![CDATA[
				public static final int STATUS_NOT_EXECUTED = 0;
				public static final int STATUS_EXECUTING = 1;
				public static final int STATUS_EXECUTED = 2;
				public static final int STATUS_CANCELED = 3;
			]]>
    </extra-code>

    <track on="UPDATE">
      <field name="unit"/>
      <field name="hatchery"/>
      <field name="canceledBy"/>
      <field name="reference"/>
      <field name="dateTime"/>
      <field name="deliveryTime"/>
      <field name="arrivalTime"/>
      <field name="cancelDate"/>
      <field name="status"/>
      <field name="note"/>

      <message if="true" on="UPDATE">Record updated</message>
    </track>

  </entity>

</domain-models>