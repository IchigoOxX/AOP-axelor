<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_6.1.xsd">
  <module name="poultryfarming" package="com.gl.apps.pf.db"/>

  <entity name="BreedingShed" >
    <many-to-many name="responsibles" ref="com.axelor.auth.db.User"/>
    <many-to-one name="breed" ref="Breed" title="Breed" readonly="true"/>
    <many-to-one name="unit" ref="com.axelor.apps.base.db.CompanyDepartment"
      title="Unit (Department)"/>
    <many-to-one name="center" ref="com.gl.apps.pf.db.Center"
      title="Center"/>

    <many-to-one name="principalBatchNumber"
      ref="com.axelor.apps.stock.db.TrackingNumber" title="Principal batch number" initParam="true"/>
    <many-to-one name="currentBatchNumber" ref="com.axelor.apps.stock.db.TrackingNumber"
      title="Current batch number" initParam="true"/>
    <many-to-one name="addressId" ref="com.axelor.apps.base.db.Address" title="Address"
      initParam="true"/>
    <many-to-one name="lastStartTechnicalSheet" ref="com.gl.apps.pf.db.StartTechnicalSheet"/>
    <many-to-one name="lastRepoTechnicalSheet" ref="com.gl.apps.pf.db.ReproTechnicalSheet"/>
    <many-to-one name="lastTechnicalSheetLine" ref="com.gl.apps.pf.db.TechnicalSheetLine"/>
    <integer name="sumNumberOfHe" title="Total number of hatching eggs" readonly="true"/>
    <integer name="sumTotalEggs" title="Total eggs" readonly="true"/>

