<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_6.1.xsd">

    <module name="poultryfarming" package="com.gl.apps.pf.db"/>

    <entity name="DashHatchery">
        <one-to-many name="hatcheryDashboardList" ref="com.gl.apps.pf.db.HatcheryDashboard" mappedBy="dashHatchery"
                     title="List"/>
        <one-to-many name="fleshLoadingProgramLineList" ref="com.gl.apps.pf.db.FleshLoadingProgramLine"
                     title="List"/>
        <one-to-many name="receiptEggsProdChicksList" ref="com.gl.apps.pf.db.DashboardReceiptEggProdChicks"
                     title="List"/>

        <track on="UPDATE">
            <field name="hatcheryDashboardList"/>
            <field name="fleshLoadingProgramList"/>
            <field name="receiptEggsProdChicksList"/>

            <message if="true" on="UPDATE">Record updated</message>
        </track>

    </entity>

</domain-models>