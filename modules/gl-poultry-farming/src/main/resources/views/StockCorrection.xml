<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_6.1.xsd">

    <form name="poultryfarming-stock-correction-form" title="Stock Correction"
          model="com.axelor.apps.stock.db.StockCorrection" onNew="action-stock-correction-onnew-group"
          onLoad="action-stock-correction-attrs-scale">
        <panel name="mainPanel">
            <panel name="statusSelectPanel" colSpan="8">
                <field name="statusSelect" showTitle="false" widget="NavSelect" colSpan="12"/>
            </panel>
            <panel name="actionsPanel" colSpan="4">
                <button name="validateBtn" title="Validate" icon="fa-check"
                        showIf="statusSelect == 1" onClick="action-group-stock-correction-validate-click"
                        colSpan="12"/>
                <button name="showGeneratedStockMoveBtn" title="Show Generated Stock Move"
                        showIf="statusSelect == 2" colSpan="12"
                        onClick="action-stock-correction-method-show-generated-stock-move"/>
            </panel>
        </panel>
        <panel name="stockCorrectionDetailsPanel" readonlyIf="statusSelect == 2">
            <field name="center" colSpan="6" domain="self.type =:_centerType" onChange="action-attrs-stock-correction-center-get-stock-location" required="true" />
            <field name="breedingShed" colSpan="6" domain="self.center = :center" onChange="action-attrs-stock-correction-breeding-shed-get-stock-location"/>
            <field name="stockLocation" canEdit="false" grid-view="stock-location-grid" readonly="true"
                   form-view="stock-location-form" onChange="action-stock-correction-method-set-deault-qtys"/>
            <field name="product" canEdit="false"
                   onSelect="action-stock-correction-on-select-product"
                   onChange="action-stock-correction-method-set-deault-qtys,action-attrs-stock-correction-info" grid-view="product-grid"
                   form-view="product-form"/>
            <field name="trackingNumber" canEdit="false"
                   onSelect="action-stock-correction-on-select-tracking-number"
                   onChange="action-stock-correction-method-set-deault-qtys"/>
            <spacer name="trackingNumberSpacer"/>
            <field name="baseQty" colSpan="3"/>
            <field name="realQty" colSpan="3" onChange="action-stock-correction-calculate-units-number,action-stock-correction-calculate-total-amount"/>
            <field name="salePrice" title="Sale price" readonly="true" colSpan="3" x-precision="5" x-scale="2"/>
            <field name="unitsNumber" title="Unit number" readonly="true" colSpan="3" x-precision="5" x-scale="2"/>
            <field name="grossMass" title="Gross mass" readonly="true" colSpan="3" x-precision="5" x-scale="2"/>
            <field name="totalAmount" readonly="true" title="Total amount" colSpan="6" x-precision="5" x-scale="2"/>
        </panel>
        <panel name="stockCorrectionReasonPanel" sidebar="true" readonlyIf="statusSelect == 2">
            <field name="stockCorrectionReason" canEdit="false" colSpan="12" required="true"/>
            <field name="validationDateT"/>
        </panel>
    </form>

    <action-attrs name="action-attrs-stock-correction-info" model="com.axelor.apps.stock.db.StockCorrection">
        <attribute if="product != null" name="value" expr="eval: (float) product.salePrice" for="salePrice"/>
        <attribute if="product != null" name="value" expr="eval: product.grossMass" for="grossMass"/>
    </action-attrs>

    <action-attrs name="action-attrs-stock-correction-center-get-stock-location"
                  model="com.axelor.apps.stock.db.StockCorrection">
        <attribute if="center != null" for="stockLocation" name="value"
                   expr="eval: center.physicalLocation"/>
    </action-attrs>

    <action-attrs name="action-attrs-stock-correction-breeding-shed-get-stock-location"
                  model="com.axelor.apps.stock.db.StockCorrection">
        <attribute if="breedingShed != null" for="stockLocation" name="value"
                   expr="eval: breedingShed.stockLocation"/>
    </action-attrs>

    <action-attrs name="action-stock-correction-calculate-units-number" model="com.axelor.apps.stock.db.StockCorrection">
        <attribute name="value" expr="eval: (float) (realQty / new BigDecimal(grossMass))" for="unitsNumber"/>
    </action-attrs>


    <action-attrs name="action-stock-correction-calculate-total-amount"
                  model="com.axelor.apps.stock.db.StockCorrection">
        <attribute for="totalAmount" name="value" expr="eval: (float) salePrice * realQty"/>
    </action-attrs>



</object-views>



