<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_6.1.xsd">

    <form id="sale-order-form-id" name="sale-order-form" title="Sale order" model="com.axelor.apps.sale.db.SaleOrder"
          extension="true" >
        <extend target="//panel-related[@name='detailLinesPanel']">
            <attribute name="onChange" value="action-attrs-delivery-date-required-params,action-sale-order-line-change-group"/>
        </extend>
        <extend target="//field[@name='estimatedDeliveryDate']">
            <attribute name="requiredIf" value="fleshChicks == true"/>
        </extend>
        <extend target="//field[@name='fiscalPosition']">
            <insert position="after">
                <field name="fleshChicks" hidden="true"/>
            </insert>
        </extend>
    </form>

    <action-attrs name="action-attrs-delivery-date-required-params" model="com.axelor.apps.sale.db.SaleOrder">
        <attribute name="value"
                   expr="eval: __config__.app.isApp('poultry-farming') &amp;&amp; saleOrderLineList?.any({it.product == __config__.app.getApp('poultry-farming')?.chairChicks })"
                   for="fleshChicks"/>
    </action-attrs>


</object-views>



