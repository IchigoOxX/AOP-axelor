                                <table border="0" cellpadding="1" cellspacing="1" style="height:40px; width:100%;">
                                   <tbody>
                                    <tr>
                                     <td style="text-align: center; background-color: rgb(238, 238, 238);"><strong><span style="color:#2980b9;"><span style="font-size:22px;">{{$fmt('status')}}</span></span></strong></td>
                                    </tr>
                                   </tbody>
                                </table>
                              ]]></viewer>
                        </field>
                    </panel>
                    <panel colSpan="12">
                        <button name="validerBtn" title="Validate" showIf="status &lt; 1 &amp;&amp; id != null" prompt="Are you sure to validate this chicks reception ?"
                                colSpan="12" icon="fa-check" css="btn-success" onClick="save,action-validation-receiving-chicks-line"/>
                    </panel>
                    <panel colSpan="12">
                        <button name="cancelBtn" title="Cancel reception" showIf="status == 1"
                                prompt="Are you sure you want to cancel this chicks reception ?"
                                colSpan="12" icon="fa-times" css="btn-danger"
                                onClick="poultry-farming-start-receiving-chicks-cancel"/>
                    </panel>

                </panel>
                <panel title="Chicks Infos:" colSpan="12">
                    <field name="breed" readonly="true" colSpan="4"/>
                    <field name="hatchDate" colSpan="4"/>
                    <field name="dailyAge" colSpan="4"/>
                </panel>
                <panel title="Delivery:" colSpan="12">
                    <field name="receivedFemalesNumber" colSpan="3"/>
                    <field name="receivedMalesNumber" colSpan="3"/>
                    <field name="receivedChicksNumber" colSpan="3"/>
                    <field name="costPrice" colSpan="3"/>
                </panel>
<!--                <panel title="Invoicing:" colSpan="12">-->
