        </panel-mail>
    </form>


    <grid name="receiving-chicks-grid" title="Receiving Chicks" model="com.gl.apps.pf.db.StartReceivingChicks" canNew="false" orderBy="-reference"
          edit-icon="true">
        <field name="reference" title="N°"/>
        <field name="dateTime" title="Date"/>
        <field name="center"/>
        <field name="trackingNumber"/>
        <field name="breed"/>
        <field name="dailyAge"/>
        <field name="receivedFemalesNumber"/>
        <field name="receivedMalesNumber"/>
        <field name="receivedChicksNumber"/>
        <field name="costPrice"/>
        <field name="status">
            <hilite background="green" if="$get('status') == 1"/>
            <hilite background="lightblue" if="$get('status') == 2"/>
            <hilite background="red" if="$get('status') == 3"/>
        </field>
    </grid>

    <action-group name="action-group-start-receiving-chicks-center-changed">
        <action name="action-record-start-receiving-chicks-get-center-info"/>
        <action name="action-method-receiving-chicks-get-lines-from-center"/>
    </action-group>

    <action-attrs name="action-record-start-receiving-chicks-get-supplierReception-info"
                  model="com.gl.apps.pf.db.StartReceivingChicks">
        <attribute if="supplierReception != null" for="breed" name="value"
                   expr="eval: supplierReception.currentBreed"/>
        <attribute if="supplierReception != null" for="trackingNumber" name="value"
                   expr="eval: supplierReception.currentTrackingNumber"/>
                <attribute if="supplierReception != null" for="dailyAge" name="value"
                           expr="eval: supplierReception.currentDailyAge"/>
    </action-attrs>

    <action-method name="action-method-start-receiving-chicks-get-lines-from-center">
        <call method="getLinesFromCenter"
              class="com.gl.apps.pf.web.StartReceivingChicksController"/>
    </action-method>

    <action-method name="action-method-start-get-delivery-and-supplier-from-supplier-reception">
        <call method="getValuesFromSupplierReception"
              class="com.gl.apps.pf.web.StartReceivingChicksController"/>
    </action-method>



