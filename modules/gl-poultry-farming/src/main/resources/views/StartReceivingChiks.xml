                    <field name="breedingShedActivationDate" colSpan="4"/>
                    <field name="charges" colSpan="4"/>
                    <field name="trackingNumber" colSpan="4"/>
                    <field name="dispatchStock" colSpan="4" readonly="true"/>
                </panel>
                <panel showTitle="false" colSpan="2">
                    <panel colSpan="12" showTitle="false" sidebar="true">
                        <field name="statusPanel" showTitle="false" readonly="true" sidebar="true">
