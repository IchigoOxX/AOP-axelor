<!--                    <field name="invoicedMalesNumber" colSpan="3"/>-->
<!--                    <field name="invoicedChicksNumber" colSpan="3"/>-->
<!--                    <field name="amount" colSpan="3"/>-->
<!--                </panel>-->
            </panel>
            <panel name="linesPanel" colSpan="12">
                <panel-related name="receivingChicksLineListPanel" colSpan="12" readonlyIf="status != 0"
                               editable="true" canNew="false" canRemove="false"
                               field="receivingChicksLineList"
                               form-view="receiving-chicks-line-form"
                               grid-view="receiving-chicks-line-grid" />
            </panel>
        </panel>
