        <panel showTitle="false" colSpan="12">
            <panel showTitle="false" colSpan="12">
                <panel title="Reception:" colSpan="10" readonlyIf="status != 0" >
                    <field name="center" colSpan="4" onChange="action-method-start-receiving-chicks-get-lines-from-center"
                           domain="self.type = 0"/>
                    <field name="dateTime" colSpan="4" readonly="true"/>
                    <field name="reference" colSpan="4"/>
                    <field name="supplierReception" colSpan="4" readonly="true"
                           onChange="action-method-start-get-delivery-and-supplier-from-supplier-reception,action-record-start-receiving-chicks-get-supplierReception-info"
                           domain="self.typeSelect = 3 AND self.statusSelect = 2 AND self.isReversion = FALSE"/>
