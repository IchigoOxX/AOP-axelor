    <action-method name="action-receiving-chicks-validate">
        <call method="startChicksValidate"
              class="com.gl.apps.pf.web.StartReceivingChicksController"/>
    </action-method>


    <action-validate name="action-receiving-checks-validate-check-exist-two-qte">
        <error if="receivingChicksLineList &amp;&amp; __this__.id != null &amp;&amp; __repo__(StartReceivingChicksLine).all().filter('self.receivingChicks = ?1 AND self.numberOfFemales > 0 AND self.numberOfMales > 0', __this__).count() > 0" message="You cannot fill both quantities female and male at the same time!"/>
    </action-validate>

    <action-validate name="action-receiving-checks-validate-check-female-number">
        <error if="receivingChicksLineList &amp;&amp; __this__.id != null &amp;&amp; __repo__(StartReceivingChicksLine).all().filter('self.receivingChicks = ?1 ', __this__).fetchStream().mapToInt(t-> t.getNumberOfFemales()).sum()  != __this__.getReceivedFemalesNumber()" message="The number of Females must correspond to the number of delivered females."/>
    </action-validate>

    <action-validate name="action-receiving-checks-validate-check-male-number">
        <error if="receivingChicksLineList &amp;&amp; __this__.id != null &amp;&amp; __repo__(StartReceivingChicksLine).all().filter('self.receivingChicks = ?1 ', __this__).fetchStream().mapToInt(t-> t.getNumberOfMales()).sum() != __this__.getReceivedMalesNumber()" message="The number of Male must correspond to the number of delivered males."/>
    </action-validate>

    <action-validate name="action-receiving-checks-empty-list">
        <error if="receivingChicksLineList.isEmpty()" message="You cannot validate ! The chick reception lines are empty."/>
    </action-validate>

    <action-group name="action-validation-receiving-chicks-line">
        <action name="action-receiving-checks-empty-list"/>
        <action name="action-receiving-checks-validate-check-exist-two-qte"/>
        <action name="action-receiving-checks-validate-check-female-number"/>
        <action name="action-receiving-checks-validate-check-male-number"/>
        <action name="action-receiving-chicks-validate"/>
    </action-group>

    <action-method name="poultry-farming-start-receiving-chicks-cancel">
        <call method="startChicksCancel"
              class="com.gl.apps.pf.web.StartReceivingChicksController"/>
    </action-method>

    <action-method name="poultry-farming-start-receiving-refresh-infos">
        <call method="refreshValuesFromSupplierReception"
              class="com.gl.apps.pf.web.StartReceivingChicksController"/>
    </action-method>

</object-views>
