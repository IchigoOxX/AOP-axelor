    <action-record name="action-business-project-batch-record-on-new"
                   model="com.axelor.apps.base.db.Partner">
        <field name="company" expr="eval:__user__.activeCompany"
               if="__user__.activeCompany != null"/>
        <field name="company" expr="eval:__repo__(Company).all().fetchOne()"
               if="__user__.activeCompany == null &amp;&amp; __repo__(Company).all().count() == 1"/>
    </action-record>

    <action-record name="action-attr-get-currency-value" model="com.axelor.apps.base.db.Partner">
        <field name="currency"
               expr="eval: __user__?.activeCompany?.currency"/>
    </action-record>

    <action-method name="action-method-partner-set-default-compt-values">
        <call class="com.gl.apps.pf.web.PartnerController" method="AddComptInfo"/>
    </action-method>

<!--    <action-record name="action-partner-set-is-prospect-to-false" model="com.axelor.apps.base.db.Partner">-->
<!--        <field name="isProspect" expr="0"/>-->
<!--    </action-record>-->

    <action-attrs name="action-partner-set-is-prospect-false">
        <attribute name="value" for="isProspect" expr="eval:false"/>
    </action-attrs>

</object-views>



