<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_6.1.xsd">

    <form name="purchase-order-line-logistics-sheet-form" title="Purchase order Line"
          model="com.axelor.apps.purchase.db.PurchaseOrderLine" width="large">
        <panel title="Overview" readonly="true">
            <field name="product.code" title="Code"/>
            <field name="productName"/>
            <field name="qty" />
        </panel>
    </form>

    <grid name="purchase-order-line-logistics-sheet-grid" model="com.axelor.apps.purchase.db.PurchaseOrderLine" title="PO lines" orderBy="product.code"
          canNew="false" canDelete="false" canEdit="false">
        <field name="product.code" title="Code" width="120"/>
        <field name="productName"/>
        <field name="qty" aggregate="sum" x-scale="2"/>
    </grid>

</object-views>
