        <attribute if="secondPartner != null &amp;&amp; !secondPartner.partnerAddressList?.isEmpty()" for="secondPartnerAddress" name="value"
                   expr="eval: secondPartner.partnerAddressList?.collect{it.address.addressL4}?.join(', ')"/>

    </action-attrs>

    <action-attrs name="action-car-rental-reset-second-partner-changed" model="com.axelor.apps.contract.db.Contract">
        <attribute if="secondPartner == null" for="secondPartnerName" name="value"
