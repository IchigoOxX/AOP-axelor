                   expr="eval: null"/>
        <attribute if="secondPartner == null" for="secondPartnerDrivingLicenseNumber" name="value"
                   expr="eval: null"/>
        <attribute if="secondPartner == null" for="secondPartnerDateOfDrivingLicense" name="value"
                   expr="eval: null"/>
        <attribute if="secondPartner == null" for="secondPartnerNationalIdentityCard" name="value"
                   expr="eval: null"/>
        <attribute if="secondPartner == null" for="secondPartnerPassport" name="value"
                   expr="eval: null"/>
        <attribute if="secondPartner == null" for="secondPartnerPhone" name="value"
                   expr="eval: null"/>
        <attribute if="secondPartner == null" for="secondPartnerFixedPhone" name="value"
                   expr="eval: null"/>
        <attribute if="secondPartner == null" for="secondPartnerAddress" name="value"
                   expr="eval: null"/>

    </action-attrs>

