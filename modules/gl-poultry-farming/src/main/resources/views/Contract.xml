    <action-validate name="action-validate-vehicle-oil-Change">
        <alert message="This vehicle must have an oil change as soon as possible!"
               if="vehicle &amp;&amp; vehicle.vehicleOilChange"/>
    </action-validate>

    <action-method name="action-contract-set-occupied-vehicle">
        <call class="com.gl.apps.pf.web.ContractController" method="SetVehicleOccupied"/>
    </action-method>

    <action-method name="action-contract-set-free-vehicle">
        <call class="com.gl.apps.pf.web.ContractController" method="SetVehicleFree"/>
    </action-method>

    <action-record name="action-set-default-values-terminate-date"
                   model="com.axelor.apps.contract.db.Contract">
        <field name="terminatedDate" expr="eval: __time__"/>
    </action-record>

    <action-attrs name="action-contract-scale-and-precision">
        <attribute name="scale" expr="eval: __user__.activeCompany.currency.nbrDecimalDigit" for="initialExTaxTotalPerYear"/>
        <attribute name="scale" expr="eval: __user__.activeCompany.currency.nbrDecimalDigit" for="yearlyExTaxTotalRevalued"/>
    </action-attrs>

</object-views>



