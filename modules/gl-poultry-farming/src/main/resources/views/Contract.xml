                   expr="eval: secondCompanyPartnerContracts.partnerAddressList?.collect{it.address.addressL4}?.join(', ')"/>

    </action-attrs>

    <action-record name="action-calculate-return-date-first-extension-changed" model="com.axelor.apps.contract.db.Contract">
        <field name="returnDate" expr="eval: returnDate.plusDays(firstExtensionDayNumbers)"/>

    </action-record>

    <action-record name="action-calculate-minus-return-date-first-extension-changed" model="com.axelor.apps.contract.db.Contract">
        <field if="firstExtensionDayNumbers == 0" name="returnDate" expr="eval: returnDate.minusDays(firstExtensionDayNumbers)"/>
    </action-record>

    <action-record name="action-calculate-return-date-second-extension-changed" model="com.axelor.apps.contract.db.Contract">
        <field name="returnDate" expr="eval: returnDate.plusDays(secondExtensionDayNumbers)"/>
    </action-record>

    <action-report name="action-report-pdf-print-fleet-contract"
                   design="contrat.rptdesign"
                   output="Check-contrat-${date}" format="pdf">
        <param name="id" expr="eval:if ( id != null) {id} else (id= 0 )"/>
    </action-report>

