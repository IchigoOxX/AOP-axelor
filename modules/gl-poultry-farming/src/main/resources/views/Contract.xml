        <attribute if="secondPartner != null" for="secondPartnerBirthPlace" name="value"
                   expr="eval: secondPartner.placeOfBirth"/>
        <attribute if="secondPartner != null" for="secondPartnerDrivingLicenseNumber" name="value"
                   expr="eval: secondPartner.drivingLicenseNumber"/>
        <attribute if="secondPartner != null" for="secondPartnerDateOfDrivingLicense" name="value"
