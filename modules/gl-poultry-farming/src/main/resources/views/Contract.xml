    <action-attrs name="action-car-rental-company-second-partner-changed"  model="com.axelor.apps.contract.db.Contract">
        <attribute if="secondCompanyPartnerContracts != null" for="secondPartnerName" name="value"
                   expr="eval: secondCompanyPartnerContracts.name"/>
        <attribute if="secondCompanyPartnerContracts != null" for="secondPartnerBirthDate" name="value"
                   expr="eval: secondCompanyPartnerContracts.dateOfBirth"/>
        <attribute if="secondCompanyPartnerContracts != null" for="secondPartnerBirthPlace" name="value"
                   expr="eval: secondCompanyPartnerContracts.placeOfBirth"/>
        <attribute if="secondCompanyPartnerContracts != null" for="secondPartnerDrivingLicenseNumber" name="value"
                   expr="eval: secondCompanyPartnerContracts.drivingLicenseNumber"/>
