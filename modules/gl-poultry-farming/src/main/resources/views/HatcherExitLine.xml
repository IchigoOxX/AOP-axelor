<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_6.1.xsd">

    <form name="hatcher-exit-line-form" title="Hatcher exits lines" editable="true"
          model="com.gl.apps.pf.db.HatcherExitLine" width="large">
        <panel title="Overview" colSpan="12">
            <panel title="Infos:" colSpan="10">
                <field name="incubatorTrolley" readonly="true"/>
                <field name="hatcherTrolley" readonly="true"/>
                <field name="firstLoadingNumber" readonly="true"/>
                <field name="center" readonly="true"/>
                <field name="trackingNumber" readonly="true"/>
                <field name="loadingType" readonly="true"/>
                <field name="breedingShed" readonly="true"/>
                <field name="currentDailyAge" readonly="true"/>
                <field name="currentWeeklyAge" readonly="true"/>
                <field name="hatcher" readonly="true"/>
                <field name="safe" required="true" onChange="action-method-hatcher-exit-line-safe"/>
                <field name="safeRate" readonly="true"/>
                <field name="sort" required="true" onChange="action-method-hatcher-exit-line-sort"/>
                <field name="sortRate" readonly="true"/>
                <field name="mortality" required="true" onChange="action-method-hatcher-exit-line-mortality"/>
                <field name="mortalityRate" readonly="true"/>
                <field name="total" readonly="true"/>
                <field name="totalRate" readonly="true"/>
            </panel>
            <panel showTitle="false" colSpan="2">
                <panel showTitle="false" colSpan="12" sidebar="true">
                    <field name="statusPanel" showTitle="false" readonly="true" sidebar="true">
                        <viewer depends="status"><![CDATA[
                                    <table border="0" cellpadding="1" cellspacing="1" style="height:40px; width:100%;">
                                        <tbody>
                                            <tr>
                                                <td style="text-align: center; background-color: rgb(238, 238, 238);">
                                                   <strong>
                                                        <span style="font-size:22px; color: {{$fmt('status') == 0 ? '#2980b9' : ($fmt('status') == 1 ? 'green' : ($fmt('status') == 2 ? 'lightblue' : ($fmt('status') == 3 ? 'orange' : 'red')))}}">
                                                            {{$fmt('status')}}
                                                        </span>
                                                   </strong>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                ]]></viewer>
                    </field>
                </panel>
            </panel>
        </panel>
    </form>

    <grid name="hatcher-exit-line-grid" title="Hatcher exits lines" model="com.gl.apps.pf.db.HatcherExitLine" edit-icon="true" orderBy="incubatorTrolley">
        <field name="incubatorTrolley" readonly="true"/>
        <field name="hatcherTrolley" readonly="true"/>
        <field name="firstLoadingNumber" readonly="true"/>
        <field name="center" readonly="true"/>
        <field name="trackingNumber" readonly="true"/>
        <field name="loadingType" readonly="true"/>
        <field name="breedingShed" readonly="true"/>
        <field name="currentDailyAge" readonly="true"/>
        <field name="currentWeeklyAge" readonly="true"/>
        <field name="hatcher" readonly="true"/>
        <field name="safe" required="true" onChange="action-method-hatcher-exit-line-safe"/>
        <field name="safeRate" readonly="true"/>
        <field name="sort" required="true" onChange="action-method-hatcher-exit-line-sort"/>
        <field name="sortRate" readonly="true"/>
        <field name="mortality" required="true" onChange="action-method-hatcher-exit-line-mortality"/>
        <field name="mortalityRate" readonly="true"/>
        <field name="total" readonly="true"/>
        <field name="totalRate" readonly="true"/>
        <field name="status" title="Hatcher trolley status">
            <hilite background="cyan" if="$get('status') == 0"/>
            <hilite background="green" if="$get('status') == 1"/>
            <hilite background="lightblue" if="$get('status') == 2"/>
            <hilite background="cyan" if="$get('status') == 3"/>
            <hilite background="orange" if="$get('status') == 4"/>
            <hilite background="red" if="$get('status') == 5"/>
        </field>
    </grid>

    <action-method name="action-method-hatcher-exit-line-safe">
        <call class="com.gl.apps.pf.web.HatcherExitController" method="redistributeSafeValues"/>
    </action-method>

    <action-method name="action-method-hatcher-exit-line-mortality">
        <call class="com.gl.apps.pf.web.HatcherExitController" method="redistributeSafeValuesMortality"/>
    </action-method>

    <action-method name="action-method-hatcher-exit-line-sort">
        <call class="com.gl.apps.pf.web.HatcherExitController" method="redistributeSafeValuesSort"/>
    </action-method>
</object-views>
