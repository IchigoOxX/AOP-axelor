<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_6.1.xsd">

<grid name="hatcher-trolley-grid" title="Hatcher Trolley"
    model="com.gl.apps.pf.db.HatcherTrolley" canNew="false" canEdit="false"
    canSave="false" canDelete="false" edit-icon="false">
    <hilite background="white" if="status == 0"/>
    <hilite background="red" if="status == 1 "/>
    <hilite background="lightgreen" if="status == 2"/>
    <hilite background="yellow" if="status == 3"/>
    <field name="reference"/>
    <field name="hatcher"/>
    <field name="hatchery"/>
    <field name="status"/>

  </grid>

  <form name="hatcher-trolley-form" title="Hatcher trolley" width="large" model="com.gl.apps.pf.db.HatcherTrolley" onLoad="action-record-get-hatcher-trolley-capacity-baskets" canNew="false">
    <panel title="Overview">
        <panel colSpan="6">
            <field colSpan="12" name="reference"/>
            <field colSpan="12" name="capacityOfACartInBaskets"/>
            <field  colSpan="12" name="hatchery" readonly="true"/>
        </panel>
        <panel colSpan="6" readonly="true">
            <field colSpan="12" name="statusDate"/>
            <field colSpan="12" name="status"/>
        </panel>
    </panel>

    <panel-mail name="mailsPanel">
      <mail-messages limit="4"/>
      <mail-followers/>
    </panel-mail>
  </form>



    <cards name="hatcher-trolley-cards" title="Hatcher Trolley" css="rect-image" model="com.gl.apps.pf.db.HatcherTrolley" width="10%" orderBy="reference" canNew="false">
        <field name="reference"/>
        <field name="hatcher.reference"/>
        <field name="hatchery.hatcheryRef"/>
        <field name="status"/>
        <template><![CDATA[
            <table border="1" cellpadding="1"  style="background-color: {{status == 0 ? 'white' : (status == 1 ? 'OrangeRed' : (status == 2 ? 'lime' : 'yellow')) }}; height:5px; width:100%"">
            <tbody>
              <tr>
                <td style="text-align:center">
            <p><strong>{{$fmt('reference')}}</strong></p>
                 <p style="text-align: left;"><strong>Elc: {{$fmt('hatcher.reference')}} </strong></p>
                 <p style="text-align: left;"><strong>Cov: {{$fmt('hatchery.hatcheryRef')}} </strong></p>
                </td>
              </tr>
            </tbody>
          </table>
        ]]></template>
    </cards>

    <action-record name="action-record-get-hatcher-trolley-capacity-baskets" model="com.gl.apps.pf.db.HatcherTrolley">
        <field if="id != null" name="capacityOfACartInBaskets" expr="eval: hatchery.capacityOfACartInBaskets"/>
    </action-record>

</object-views>
