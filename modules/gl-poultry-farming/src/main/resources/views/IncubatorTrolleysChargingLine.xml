<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_6.1.xsd">

    <grid name="incubator-trolleys-charging-line-grid" title="Incubator Trolleys Charging Line" orderBy="breedingShed"
          model="com.gl.apps.pf.db.IncubatorTrolleysChargingLine">
        <field name="lineNumber"/>
        <field name="incubatorTrolley" required="true" onChange="action-group-incubator-trolleys-charging-line-incubator-trolley-changed"/>
        <field name="center" onChange="get-center-info-incubator-trolleys-charging-line-group"/>
        <field name="chargingType"/>
        <field name="breedingShed"/>
        <field name="numberOfEggTrays"/>
        <field name="numberOfEggs"/>
        <field name="breed" readonly="true"/>
        <field name="batchNumber" readonly="true"/>
        <field name="sumEggs" title="Sum of eggs" />
        <field name="sumEggsTrays" title="Sum of eggs trays"/>
    </grid>

    <form name="incubator-trolleys-charging-line-form" title="Incubator Trolleys Charging Line" model="com.gl.apps.pf.db.IncubatorTrolleysChargingLine"
          onLoad="action-record-get-capacity-of-egg-tray"
          onNew="action-record-get-capacity-of-egg-tray">
        <panel title="Overview" readonlyIf="!__parent__.isValid">
            <panel colSpan="12">
                <field name="center" domain="self.type = 1"
                       onChange="get-center-info-incubator-trolleys-charging-line-group"/>
                <field name="incubatorTrolley" target-name="reference" domain="self.status = 0" required="true"
                       onChange="action-group-incubator-trolleys-charging-line-incubator-trolley-changed"/>
                <field name="chargingType"/>
                <field name="breed" readonly="true"/>
                <field name="batchNumber" readonly="true"/>
                <field name="_capacityOfAnEggTray" title="Capacity of an egg tray" readonly="true"/>
            </panel>
            <panel colSpan="12">
                <field name="numberOfEggTrays" onChange="action-attrs-calcul-numberOfEggs"/>
                <field name="numberOfEggs" onChange="action-attrs-calcul-numberOfEggTrays"/>
            </panel>
        </panel>
        <panel-related name="reproProductionLineListPanel" readonlyIf="!__parent__.isValid"
                       colSpan="12" field="chargingLineDetailList"
                       form-view="incubator-trolleys-charging-line-detail-form"
                       grid-view="incubator-trolleys-charging-line-detail-grid"
                       onChange="action-group-panel-related-changed" editable="true"
                       canNew="false" canRemove="false"/>

        <panel-mail name="mailsPanel">
            <mail-messages limit="4"/>
            <mail-followers/>
        </panel-mail>
    </form>

    <action-group name="get-center-info-incubator-trolleys-charging-line-group">
        <action name="get-center-info-incubator-trolleys-charging-line"/>
        <action name="action-method-incubator-trolley-charging-get-lines-from-center"/>
        <action name="get-center-empty-incubator-trolleys-charging-line"/>
    </action-group>

    <action-attrs name="get-center-info-incubator-trolleys-charging-line"
                  model="com.gl.apps.pf.db.IncubatorTrolleysChargingLine">
        <attribute if="center != null" name="value" expr="eval: center.currentTrackingNumber" for="batchNumber"/>
        <attribute if="center != null" name="value" expr="eval: center.currentBreed" for="breed"/>
    </action-attrs>

    <action-attrs name="get-center-empty-incubator-trolleys-charging-line" model="com.gl.apps.pf.db.IncubatorTrolleysChargingLine">
        <attribute if="center == null" name="value" expr="eval: null" for="batchNumber"/>
        <attribute if="center == null" name="value" expr="eval: null" for="breed"/>
        <attribute if="center == null" name="value" expr="eval: null" for="chargingLineDetailList"/>
    </action-attrs>


    <action-attrs name="get-incubator-trolley-info-incubator-trolleys-charging-line"
                  model="com.gl.apps.pf.db.IncubatorTrolleysChargingLine">
        <attribute if="incubatorTrolley != null" name="value"
                   expr="eval: incubatorTrolley.hatchery.capacityOfATrolleyInTrays" for="numberOfEggTrays"/>
        <attribute if="incubatorTrolley != null" name="value"
                   expr="eval: incubatorTrolley.hatchery.capacityOfATrolleyInTrays * incubatorTrolley.hatchery.capacityOfAnEggTray"
                   for="numberOfEggs"/>
    </action-attrs>

    <action-attrs name="get-incubator-trolley-empty-incubator-trolleys-charging-line"
                  model="com.gl.apps.pf.db.IncubatorTrolleysChargingLine">
        <attribute if="incubatorTrolley == null" name="value"
                   expr="eval: 0" for="numberOfEggTrays"/>
        <attribute if="incubatorTrolley == null" name="value"
                   expr="eval: 0" for="numberOfEggs"/>
    </action-attrs>

    <action-group name="action-group-incubator-trolleys-charging-line-incubator-trolley-changed">
        <action name="get-incubator-trolley-info-incubator-trolleys-charging-line"/>
        <action name="get-incubator-trolley-empty-incubator-trolleys-charging-line"/>
    </action-group>

    <action-attrs name="action-attrs-calcul-numberOfEggs" model="com.gl.apps.pf.db.IncubatorTrolleysChargingLine">
        <attribute if="numberOfEggTrays != 0" name="value"
                   expr="eval: (int) Math.ceil(_capacityOfAnEggTray * numberOfEggTrays)"
                   for="numberOfEggs"/>
    </action-attrs>

    <action-attrs name="action-attrs-calcul-numberOfEggTrays" model="com.gl.apps.pf.db.IncubatorTrolleysChargingLine">
        <attribute if="numberOfEggs != 0" name="value"
                   expr="eval: (int) Math.ceil((double) numberOfEggs / _capacityOfAnEggTray)"
                   for="numberOfEggTrays"/>
    </action-attrs>

    <action-method name="action-method-incubator-trolley-charging-get-lines-from-center">
        <call method="getLinesFromCenter"
              class="com.gl.apps.pf.web.IncubatorTrolleysChargingLineController"/>
    </action-method>

    <action-validate name="action-incubator-charging-line-validate-eggs-number">
        <error message="Total number of eggs transferred must be less than incubator trolley's capacity."
               if="eval: chargingLineDetailList?.collect(){ it?.numberOfEggs }?.sum() > numberOfEggs"/>
    </action-validate>

    <action-record name="action-record-get-capacity-of-egg-tray" model="com.gl.apps.pf.db.IncubatorTrolleysChargingLine">
        <field name="_capacityOfAnEggTray" expr="eval: __parent__.hatchery.capacityOfAnEggTray"/>
    </action-record>

    <action-record name="action-record-get-sum-eggs-and-trays" model="com.gl.apps.pf.db.IncubatorTrolleysChargingLine">
        <field if="chargingLineDetailList != null &amp;&amp; !chargingLineDetailList.empty" name="sumEggs" expr="eval: eval: chargingLineDetailList?.collect{it->it.numberOfEggTrays}?.sum()"/>
        <field if="chargingLineDetailList != null &amp;&amp; !chargingLineDetailList.empty" name="sumEggsTrays" expr="eval: eval: chargingLineDetailList?.collect{it->it.numberOfEggs}?.sum()"/>
    </action-record>
    <action-group name="action-group-panel-related-changed">
        <action name="action-incubator-charging-line-validate-eggs-number"/>
        <action name="action-record-get-sum-eggs-and-trays"/>
    </action-group>


</object-views>
