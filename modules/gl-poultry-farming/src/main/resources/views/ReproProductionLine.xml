  <grid name="repro-production-line-grid" title="Repro production lines" model="com.gl.apps.pf.db.ReproProductionLine" orderBy="breedingShed" edit-icon="true">
    <field name="breedingShed" title="Breeding Shed" readonly="true"/>
    <field name="numberOfHeTrays" onChange="action-repro-production-line-calculate-het,action-repro-production-line-calculate-tot" readonly="true"/>
    <field name="numberOfHe" onChange="action-repro-production-line-calculate-he,action-repro-production-line-calculate-tot"/>
    <field name="numberOfHeGround" title="Number of hatching eggs ground" onChange="action-repro-production-line-calculate-he,action-repro-production-line-calculate-tot"/>
    <field name="totalNumberOfHe" readonly="true"/>

    <field name="numberOfDYETrays" readonly="true" onChange="action-repro-production-line-calculate-dyet,action-repro-production-line-calculate-tot"/>
    <field name="numberOfDYE" onChange="action-repro-production-line-calculate-dye,action-repro-production-line-calculate-tot"/>

    <field name="numberOfDETrays" readonly="true" onChange="action-repro-production-line-calculate-det,action-repro-production-line-calculate-tot"/>
    <field name="numberOfDE" onChange="action-repro-production-line-calculate-de,action-repro-production-line-calculate-tot"/>
    <field name="numberOfDEGround" title="Number of declassed eggs ground" onChange="action-repro-production-line-calculate-de,action-repro-production-line-calculate-tot"/>
    <field name="totalNumberOfDE" readonly="true"/>

    <field name="totalTrays"/>
    <field name="totalEggs"/>
    <field name="numberOfRE" onChange="action-repro-production-line-calculate-tot"/>
    <field name="numberOfDestroyedRe" onChange="action-repro-production-line-calculate-tot"/>
<!--    <field name="unfertilizedEggs"/>-->
  </grid>

  <action-attrs name="action-repro-production-line-calculate-het"
    model="com.gl.apps.pf.db.ReproProduction">
    <attribute for="numberOfHe" name="value" expr="eval: numberOfHeTrays * 30"/>
    <attribute for="totalTrays" name="value"
      expr="eval: numberOfHeTrays + numberOfDYETrays + numberOfDETrays"/>
  </action-attrs>

  <action-attrs name="action-repro-production-line-calculate-he"
    model="com.gl.apps.pf.db.ReproProduction">
    <attribute for="numberOfHeTrays" name="value"
      expr="eval: (int) Math.ceil((numberOfHe + numberOfHeGround) / 30)"/>
  </action-attrs>

  <action-attrs name="action-repro-production-line-calculate-dyet"
    model="com.gl.apps.pf.db.ReproProduction">
    <attribute for="numberOfDYE" name="value" expr="eval: numberOfDYETrays * 30"/>
  </action-attrs>

  <action-attrs name="action-repro-production-line-calculate-dye"
    model="com.gl.apps.pf.db.ReproProduction">
    <attribute for="numberOfDYETrays" name="value"
      expr="eval: (int) Math.ceil(numberOfDYE / 30)"/>
  </action-attrs>

  <action-attrs name="action-repro-production-line-calculate-det"
    model="com.gl.apps.pf.db.ReproProduction">
    <attribute for="numberOfDE" name="value" expr="eval: numberOfDETrays * 30"/>
  </action-attrs>

  <action-attrs name="action-repro-production-line-calculate-de"
    model="com.gl.apps.pf.db.ReproProduction">
    <attribute for="numberOfDETrays" name="value"
      expr="eval: (int) Math.ceil((numberOfDE + numberOfDEGround + numberOfDestroyedRe) / 30)"/>
  </action-attrs>

  <action-attrs name="action-repro-production-line-calculate-tot" model="com.gl.apps.pf.db.ReproProduction">
    <attribute name="value" expr="eval: totalNumberOfHe + numberOfDYE + numberOfDE + numberOfDestroyedRe + numberOfRE" for="totalEggs"/>
    <attribute name="value" expr="eval: numberOfHeTrays + numberOfDYETrays + numberOfDETrays" for="totalTrays"/>
    <attribute name="value" expr="eval: numberOfHe + numberOfHeGround" for="totalNumberOfHe"/>
    <attribute name="value" expr="eval: numberOfDE + numberOfDEGround" for="totalNumberOfDE"/>
  </action-attrs>


</object-views>
