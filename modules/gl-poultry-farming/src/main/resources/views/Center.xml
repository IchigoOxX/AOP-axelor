<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_6.1.xsd">

  <grid name="center-grid" title="Center" model="com.gl.apps.pf.db.Center"
      edit-icon="true">
      <field name="reference"/>
      <field name="name"/>
      <field name="type"/>
    </grid>

  <form name="center-form" title="Center" model="com.gl.apps.pf.db.Center"
        onNew="action-center-method-on-new"
        onSave="save,action-validate-center-breeding-shed-list">
    <panel title="Centers" colSpan="12">
      <field name="reference" title="Reference"/>
      <field name="name" title="Name"/>
      <field name="type" readonlyIf="breedingShedList.length > 0" title="Center type"/>
      <field name="hatchery" title="Default Hatchery" showIf="type == 1"/>
      <field name="unit" title="Unit" canNew="true" canEdit="true" canView="true"/>
      <field name="physicalLocation" title="Physical location" canNew="true" canEdit="true" canView="true"/>

      <field name="associatedProductType" title="Associated product type"/>
    </panel>
    <panel title="Actual info" showIf="id != null" colSpan="12">
      <panel colSpan="6">
        <field name="currentBreed"/>
        <field name="currentTrackingNumber"/>
      </panel>
      <panel colSpan="6">
        <field name="currentWeeklyAge"/>
        <field name="currentDailyAge"/>
      </panel>
    </panel>
    <panel-related name="breedingShedPanel" title="Breeding Sheds List" colSpan="12"
                   field="breedingShedList"
                   form-view="breedingShed-form"
                   grid-view="breedingShed-grid" editable="true" canRemove="false"/>
    <panel title="Responsible" showTitle="false" colSpan="10">
      <panel-related title="Responsible" colSpan="50" css="center" field="responsible"
                     form-view="user-BreedingShed-form"
                     grid-view="user-BreedingShed-grid"
                     canSelect="true" canNew="false" canEdit="false"/>
    </panel>
    <panel-mail name="mailsPanel">
      <mail-messages limit="4"/>
      <mail-followers/>
    </panel-mail>
  </form>

  <cards name="center-cards" title="Center" css="rect-image" model="com.gl.apps.pf.db.Center" width="400px" orderBy="type">
    <field name="reference"/>
    <field name="name"/>
    <field name="type"/>
    <field name="unit"/>
    <field name="physicalLocation"/>
    <field name="currentBreed"/>
    <field name="status"/>
    <template><![CDATA[
      <div class="span12">
          <strong><span x-translate>Center : </span> {{ name }}</strong>
          <a class="pull-right muted">{{ $fmt('reference') }}</a>
      </div>
      <div>
        <div>
            <div class="span8">
              <i class="fa fa-tint" aria-hidden="true"></i>
              {{ currentBreed.name }}
            </div>
             <div class="span8" style="margin-left:-1px;">
              <i class="fa fa-map-marker" aria-hidden="true"></i>
              {{ physicalLocation.name }}
            </div>
        </div>
            <div class="span6" style="margin-left:0px;">
                  <h5>
                      <span ng-show="type == 0" class="label label-default" style="background-color: #ec7575;" x-translate>Startup</span>
                      <span ng-show="type == 1" class="label label-default" style="background-color: #f28f16;" x-translate>Reproduction</span>
                      <span ng-show="type == 2" class="label label-default" style="background-color: #7fd3f7;" x-translate>Boiler</span>

                      <span class="label label-default" style="background-color: #1eb19d;" x-translate>{{ unit.name }}</span>
                  </h5>
            </div>
        <div>
      </div>
      ]]></template>
  </cards>

  <action-validate name="action-validate-center-breeding-shed-list">
    <error if="breedingShedList != null &amp;&amp; breedingShedList?.any { it.type != type }" message="Breeding sheds list's type must have the same center's type."/>
  </action-validate>

  <action-method name="action-center-method-on-new">
    <call class="com.gl.apps.pf.web.CenterController" method="onNew"/>
  </action-method>

  <action-attrs name="action-attrs-company-unit-domain">
    <attribute
            name="domain"
            for="unit"
            expr="eval: 'self.id IN (' + (__user__.activeCompany?.companyDepartmentList?.collect{ it.id }?.join(',') ?: '0') + ')'"
            if="__user__.activeCompany?.companyDepartmentList &amp;&amp; !__user__.activeCompany.companyDepartmentList.isEmpty()"/>
  </action-attrs>


</object-views>
