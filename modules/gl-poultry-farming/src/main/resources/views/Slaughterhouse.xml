<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_6.1.xsd">

    <grid name="slaughterhouse-grid" title="Slaughterhouse" model="com.gl.apps.pf.db.Slaughterhouse"
          edit-icon="true">
        <field name="reference"/>
        <field name="name"/>
        <field name="type"/>
        <field name="unit" title="Unit"/>

    </grid>

    <form name="slaughterhouse-form" title="Slaughterhouse" model="com.gl.apps.pf.db.Slaughterhouse">
        <panel title="Slaughterhouses" colSpan="12">
            <field name="reference" title="Reference"/>
            <field name="name" title="Name"/>
            <field name="type" title="Type"/>
            <field name="unit" title="Unit" canNew="true" canEdit="true" canView="true"/>
            <field name="physicalLocation" title="Physical location" required="true" canNew="true" canEdit="true" canView="true"/>
        </panel>
        <panel title="Responsible" showTitle="false" colSpan="10">
            <panel-related title="Responsible" colSpan="50" css="center" field="responsibles"
                           form-view="user-BreedingShed-form"
                           grid-view="user-BreedingShed-grid"
                           canSelect="true" canNew="false" canEdit="false"/>
        </panel>
       <panel-mail name="mailsPanel">
            <mail-messages limit="4"/>
            <mail-followers/>
        </panel-mail>
    </form>

    <cards name="slaughterhouse-cards" css="rect-image" title="Slaughterhouse" model="com.gl.apps.pf.db.Slaughterhouse" width="400px">
        <field name="reference"/>
        <field name="name"/>
        <field name="unit"/>
        <field name="type"/>

        <field name="physicalLocation"/>
        <template><![CDATA[
        <div class="span12">
            <strong><span x-translate>Slaughterhouse : </span> {{ name }}</strong>
            <a class="pull-right muted">{{ $fmt('reference') }}</a>
        </div>
        <div>
          <div>
               <div class="span8" style="margin-left:-1px;">
                <i class="fa fa-map-pin" aria-hidden="true"></i>
                {{physicalLocation.name}}
              </div>
          </div>
              <div class="span6" style="margin-left:0px;">
                    <h5>
                        <span class="label label-important" ng-show="type == 0" x-translate>Principal</span>
                        <span class="label label-info" x-translate>{{ unit.name }}</span>
                    </h5>
              </div>
          <div>
        </div>
        ]]></template>
    </cards>

</object-views>
