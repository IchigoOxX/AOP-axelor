            <xml-property name="queryText"><![CDATA[SELECT 
fvmk.name ,
fvm.model ,
cc.plate_no ,
bp.name as firstcondn,
bp.first_name as firstcondnf  ,
bp.mobile_phone as mobp1,
bp.date_of_birth as birthdayp1,
bp.place_of_birth as birthplacep1 ,
coalesce(bp.passport,'') as passportp1 ,
coalesce(bp.national_identity_card,'') as cinp1 ,
bp.driving_license_number as permip1 ,
bp.date_of_driving_license as datepermip1 ,
bp.expiry_date as datecin1,
ba.full_name as adressp1 ,
coalesce(bp1.name,'') as namecond2 ,
coalesce(bp1.first_name,'') as firstnemecond2,
coalesce(bp1.mobile_phone,'') as mobcond2,
bp1.date_of_birth as birthdayp2,
coalesce(bp1.place_of_birth,'') as birthplacep2 ,
coalesce(bp1.passport,'') as passportp2 ,
coalesce(bp1.national_identity_card,'') as cinp2 ,
coalesce(bp1.driving_license_number,'') as permip2 ,
bp1.date_of_driving_license as datepermip2 ,
bp1.date_of_birth as birthdayp2,
bp1.expiry_date as datecin2,
coalesce(ba1.full_name,'') as adress2 ,
cc.departure_date,
cc.departure_time,
cc.return_date,
cc.return_time,
cc.first_extension_day_numbers as prolong1,
second_extension_day_numbers as prolon2
FROM contract_contract cc 
left join fleet_vehicle fv on fv.id = cc.vehicle
left join base_partner bp on bp .id = cc.partner
left join base_address ba on ba.id = bp.main_address
left join base_partner bp1 on bp1 .id = cc.second_partner
left join base_address ba1 on ba1.id = bp1.main_address
left join fleet_vehicle_model fvm on fvm.id = fv.vehicle_model
left join fleet_vehicle_make fvmk on fvmk.id = fvm.vehicle_make
where 
cc.id =?]]></xml-property>
        </oda-data-set>
    </data-sets>
