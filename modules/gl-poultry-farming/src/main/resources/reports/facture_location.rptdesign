            <xml-property name="queryText"><![CDATA[select 
i.invoice_id ,
i.invoice_date,
i.tax_stamp as timbre ,
p.simple_full_name as partner,
fvmk.name as vhiculemarque ,
fvm.model as vehiclemodel,
cc.plate_no as vehiculeserie,
cc.departure_date ,
cc.departure_time,
cc.return_date ,
cc.return_time,
bp.code as product_code,
bp.name as prodeuct_name,
il.qty as quantity,
il.price as prix_unitaire ,
il.ex_tax_total as pht,
il.tax_rate as tax ,
il.in_tax_total pttc ,
i.tax_stamp as timbre,
i.tax_total as totaltax ,
i.ex_tax_total as totht,
i.in_tax_total as totttc ,
fn_nombre_en_chiffre_devise(i.in_tax_total,'DINARS', 'MILLIMES',true) as ttc_lettre 
from account_invoice i 
left join base_partner p on p.id = i.partner
left join account_invoice_line il on il.invoice = i.id 
left join base_product bp on bp.id = il.product
left join contract_contract cc on cc.id = i.contract
left join fleet_vehicle fv on fv.id = cc.vehicle
left join fleet_vehicle_model fvm on fvm.id = fv.vehicle_model
left join fleet_vehicle_make fvmk on fvmk.id = fvm.vehicle_make 
where i.id =?]]></xml-property>
