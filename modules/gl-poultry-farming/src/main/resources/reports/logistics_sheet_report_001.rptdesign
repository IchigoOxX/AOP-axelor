            <xml-property name="queryText"><![CDATA[select
    pls.id,
    pls.archived,
    pls.import_id,
    pls.import_origin,
    pls.process_instance_id,
    pls."version",
    pls.created_on,
    pls.updated_on,
    pls.algex,
    pls.arrival_date,
    pls.attrs,
    pls.contract_number,
    pls.date_time,
    pls.dhl,
    pls.domiciliation_tax,
    pls.expected_arrival_date,
    pls.expected_loading_date,
    pls.expected_production_date,
    pls.predom,
    pls.pro_format,
    pls.reference,
    pls.shipping_date,
    pls.status,
    pls.created_by,
    pls.updated_by,
    pls.brand,
    pls.supplier,
    bp."name" as partner_name,
    bp.full_name as partner_full_name,
    bpf."name" as product_family_name,
    bpf.code as product_family_code,
    bc."name" as company_name,
    mf.file_path as company_logo,
    ppo.full_name as pro_format_name,
    ppol.product_name as line_product_name,
    ppol.qty as line_product_qte,
    cc.contract_id as contract_name,
    bp2.full_name as carrier_name
from
    public.pf_logistics_sheet pls
inner join public.base_product_family bpf on
    pls.brand = bpf.id
inner join public.base_company bc on
    bc.id = pls.company
inner join public.base_partner bp2 on
    pls.carrier = bp2.id
inner join public.purchase_purchase_order_line ppol on
    ppol.purchase_order  = pls.pro_format
inner join public.base_partner bp on
    pls.supplier = bp.id
inner join public.contract_contract cc on
    pls.contract_number = cc.id
inner join public.meta_file mf on
    bc.logo = mf.id
inner join public.purchase_purchase_order ppo on
    pls.pro_format = ppo.id
where
    pls.id = ?;
]]></xml-property>
