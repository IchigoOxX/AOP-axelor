          <field name="invoiceAutomaticMail"/>
          <field name="invoiceMessageTemplate" showIf="invoiceAutomaticMail" domain="self.metaModel.name = 'Invoice'" requiredIf="invoiceAutomaticMail"/>
        </panel>
        <button name="messageBtn" title="Show mail" showIf="[2,3].includes(statusSelect) &amp;&amp; ( invoiceAutomaticMail || invoiceAutomaticMailOnValidate )" colSpan="3" css="btn-custom" onClick="action.message.view.messages"/>
      </panel>
      <panel name="blockingsPanel" title="Blockings" showTitle="false" showIf="statusSelect == 3">
        <field name="debitBlockingOk"/>
        <field name="debtRecoveryBlockingOk"/>
        <field name="billOfExchangeBlockingOk"/>
        <panel name="debitBlockingGroupPanel" title="Direct debit blocking" showIf="debitBlockingOk" colSpan="12">
          <field name="debitBlockingByUser" canNew="false" canView="false" canEdit="false" form-view="user-form" grid-view="user-grid"/>
          <field name="debitBlockingToDate"/>
          <field name="debitBlockingReason" form-view="stop-reason-form" grid-view="stop-reason-grid"/>
          <field name="commentOnDebitBlocking" colSpan="12" widget="html"/>
        </panel>
        <panel name="debtRecoveryBlockingPanel" title="Debt recovery blocking" showIf="debtRecoveryBlockingOk" colSpan="12">
          <field name="debtRecoveryBlockingByUser" canNew="false" canView="false" canEdit="false" form-view="user-form" grid-view="user-grid"/>
          <field name="debtRecoveryBlockingToDate"/>
          <field name="debtRecoveryBlockingReason" form-view="stop-reason-form" grid-view="stop-reason-grid"/>
          <field name="commentOnRecoveryBlocking" colSpan="12" widget="html"/>
        </panel>
        <panel name="debtRecoveryBlockingPanel" title="Bill of exchange blocking" showIf="billOfExchangeBlockingOk" colSpan="12">
          <field name="billOfExchangeBlockingByUser" canNew="false" canView="false" canEdit="false" form-view="user-form" grid-view="user-grid"/>
          <field name="billOfExchangeBlockingToDate"/>
          <field name="billOfExchangeBlockingReason" form-view="stop-reason-form" grid-view="stop-reason-grid"/>
          <field name="commentOnExchangeBlocking" colSpan="12" widget="html"/>
        </panel>
      </panel>
      <panel name="invoicePaymentPanel" title="Payments details" showIf="statusSelect != 1">
        <panel if="__config__.app.getApp('account')?.getActivatePassedForPayment()" name="pfpValidationPanel" showIf="pfpValidateStatusSelect > 0" colSpan="12">
          <field name="pfpValidateStatusSelect" hidden="true" colSpan="4"/>
          <field name="reasonOfRefusalToPayStr" readonly="true" showIf="reasonOfRefusalToPay  &amp;&amp; reasonOfRefusalToPayStr &amp;&amp; pfpValidateStatusSelect == 3" colSpan="12" css="red">
            <viewer><![CDATA[{{record.reasonOfRefusalToPayStr}}]]></viewer>
          </field>
        </panel>
        <panel name="financialDiscountPanel" showIf="statusSelect > 2" colSpan="12">
          <field name="financialDiscount" readonlyIf="amountPaid > 0" onChange="action-invoice-group-financial-discount"/>
          <field name="financialDiscountDeadlineDate" readonly="true" showIf="financialDiscount"/>
          <panel name="financialDiscountAmountPanel" showIf="financialDiscount" colSpan="12">
            <field name="financialDiscountRate" readonly="true"/>
            <field name="financialDiscountTotalAmount" readonly="true"/>
            <field name="remainingAmountAfterFinDiscount" readonly="true"/>
          </panel>
        </panel>
        <panel-related name="invoicePaymentListPanel" title="Payments details" colSpan="12" field="invoicePaymentList" form-view="invoice-payment-form" grid-view="invoice-payment-grid" canNew="false" canRemove="false"/>
        <field name="amountPaid" hidden="true"/>
      </panel>
      <panel if="__config__.app.getApp('account')?.getActivatePassedForPayment()" name="pfpAccountConfigPanel" hidden="true">
        <field name="$isValidPfpValidatorUser" type="boolean"/>
        <field name="$isSelectedPfpValidatorEqualsPartnerPfpValidator"/>
        <field name="$isInvoiceTermAwaiting" type="boolean"/>
        <field name="reasonOfRefusalToPay"/>
        <field name="company.accountConfig"/>
        <field name="company.accountConfig.isManagePassedForPayment"/>
        <field name="company.accountConfig.isManagePFPInRefund"/>
        <field name="$isValidInvoiceTermPfpValidateStatus" hidden="true" type="boolean"/>
      </panel>
      <panel name="budgetPanel" title="Budget" showIf="(statusSelect >= 2 &amp;&amp; statusSelect &lt; 4) || budgetDistributionGenerated">
        <panel-dashlet if="__config__.app.isApp('budget')" name="budgetDistributionPanel" title="Budget distribution" readonly="true" colSpan="12" action="action-budget-distribution-view-budget-distribution"/>
      </panel>
      <panel name="directDebitPanel" title="Direct debit" showTitle="false" showIf="statusSelect == 3 &amp;&amp; schedulePaymentOk">
        <panel name="paymentSchedulePanel" title="Payment schedule" colSpan="12">
          <field name="schedulePaymentOk" readonly="true"/>
          <field name="paymentSchedule" readonly="true" domain="self.company = :company AND self.partner = :partner" form-view="payment-schedule-form" grid-view="payment-schedule-grid"/>
        </panel>
      </panel>
    </panel-tabs>
    <panel name="actionsPanel" hideIf="partner == null" sidebar="true">
      <field name="amountRemaining" hidden="true"/>
      <field name="hasPendingPayments" hidden="true"/>
      <button name="validateBtn" title="Validate" hidden="true" onClick="action-invoice-group-on-validate"/>
      <field name="fodecTotal" hidden="true"/>
      <field name="dcTotal" hidden="true"/>
      <field name="tvaTotal" hidden="true"/>
      <button name="ventilateBtn" title="Ventilate" hidden="true" showIf="statusSelect == 2 &amp;&amp; operationSubTypeSelect != 2" prompt="Are you sure you want to ventilate the invoice ?" onClick="action-budget-invoice-group-ventilate-button"/>
      <button if="__config__.app.isApp('budget') &amp;&amp; __config__.app.getApp('budget')?.getManageMultiBudget()" name="computeBudgetDistributionBtn" title="Compute budget distribution" hidden="true" showIf="company.accountConfig.enableBudgetKey &amp;&amp; purchaseOrder == null &amp;&amp; (statusSelect == 1 || statusSelect == 2) &amp;&amp; (invoiceLineList &amp;&amp; invoiceLineList.length != 0)" onClick="action-budget-group-compute-budget-distribution"/>
      <button name="validateAndVentilateBtn" title="Validate" hidden="true" onClick="action-invoice-group-validate-and-ventilate-onclick"/>
      <panel name="paymentActionsPanel" hidden="true" showIf="id" itemSpan="12">
        <button if="__config__.app.getApp('account')?.getActivatePassedForPayment()" name="passedForPaymentValidationBtn" title="Passed for payment validation" hidden="true" css="btn-success" onClick="action-invoice-group-pfp-validate"/>
        <button if="__config__.app.getApp('account')?.getActivatePassedForPayment()" name="refusalToPayBtn" title="Refusal to pay" hidden="true" css="btn-danger" onClick="save,action-invoice-view-refusal-to-pay"/>
        <button name="cancelBtn" title="Cancel" hidden="true" css="btn-warning" prompt="Are you sure you want to cancel the invoice ?" onClick="save,action-invoice-method-cancel,save"/>
        <button name="draftBtn" title="Draft" showIf="statusSelect == 4" onClick="save,action-invoice-record-draft,save,action-account-invoice-onload-group"/>
        <button name="addPaymentBtn" title="Register payment" hidden="true" colSpan="12" onClick="action-set-contract-paid,action-invoice-group-add-invoice-payment"/>
        <button name="registerPaymentBtn" title="Register payment" hidden="true" colSpan="12" onClick="save,action-set-contract-paid,action-invoice-view-register-payment-voucher"/>
        <field name="validatedByUser" showIf="validatedByUser" colSpan="6" canView="false"/>
        <field name="validatedDateTime" hidden="true" showIf="validatedDateTime" colSpan="6"/>
        <field if="__config__.app.getApp('account')?.getActivatePassedForPayment()" name="pfpValidatorUser" hidden="true" readonlyIf="pfpValidateStatusSelect != 1" colSpan="6" canEdit="false" onChange="action-invoice-group-pfp-validator-user-onchange" onSelect="action-invoice-method-domain-pfp-validator-user-on-select"/>
        <panel if="__config__.app.getApp('account')?.getActivatePassedForPayment()" name="pfpEmailPanel" colSpan="6">
          <field name="decisionPfpTakenDateTime" hidden="true" colSpan="12"/>
          <button name="sendPfpNotifyEmailBtn" title="Send a notify email" hidden="true" colSpan="12" onClick="save,action-send-by-email-with-template"/>
        </panel>
        <field name="ventilatedByUser" hidden="true" showIf="ventilatedByUser" colSpan="6" canView="false"/>
        <field name="ventilatedDateTime" hidden="true" showIf="ventilatedDateTime" colSpan="6"/>
      </panel>
    </panel>
    <panel name="totalsPanel" title="Totals" showTitle="false" hideIf="partner == null" itemSpan="6" sidebar="true">
      <field name="currency.code" hidden="true"/>
      <field name="currency.symbol" hidden="true"/>
      <field name="inStamp" hidden="true"/>
      <field name="productWithholdingTotal" hidden="true"/>
      <field name="serviceWithholdingTotal" hidden="true"/>
      <field name="inTaxTotal" showTitle="false" colSpan="12" css="order-subtotal">
        <viewer depends="exTaxTotal,currency.symbol,taxTotal,serviceWithholdingTotal,productWithholdingTotal "><![CDATA[
		         <dl class="dl-horizontal">
		          <dt style="border-top: none; text-align: left;" x-translate>Total W.T.</dt>
                  <dd style="border-top: none; text-align: right;">{{record.exTaxTotal}}</dd>
                  <dt style="border-top: none; text-align: left;" x-translate>Total TVA</dt>
                  <dd style="border-top: none; text-align: right;">{{record.tvaTotal}}</dd>
                  <dt style="border-top: none; text-align: left;" x-translate>Total Fodec</dt>
                  <dd style="border-top: none; text-align: right;">{{record.fodecTotal}}</dd>
                  <dt style="border-top: none; text-align: left;" x-translate>Total DC</dt>
                  <dd style="border-top: none; text-align: right;">{{record.dcTotal}}</dd>
                  <dt style="border-top: none; text-align: left;" x-translate>Product withholding total</dt>
                  <dd style="border-top: none; text-align: right;">{{record.productWithholdingTotal}}</dd>
                  <dt style="border-top: none; text-align: left;" x-translate>Service withholding total</dt>
                  <dd style="border-top: none; text-align: right;">{{record.serviceWithholdingTotal}}</dd>
                  <dt style="border-top: none; text-align: left;" x-translate>Stamp</dt>
                  <dd style="border-top: none; text-align: right;">{{record.inStamp}}</dd>
                  <dt style="border-top: none; text-align: left;" x-translate>Total A.T.I.</dt>
	              <dd style="border-top: none; text-align: right;">{{record.inTaxTotal}}</dd>

<!--		          <dt x-translate>Total Fodec</dt>-->
<!--		           <dd>{{$fmt('fodecTotal') | currency: record.currency.symbol}}</dd>-->
<!--		           <dt x-translate>Total DC</dt>-->
<!--		           <dd>{{$fmt('dcTotal') | currency: record.currency.symbol}}</dd>-->
<!--		           <dt x-translate>Total W.T.</dt>-->
<!--		           <dd>{{$fmt('exTaxTotal') | currency: record.currency.symbol}}</dd>-->
<!--		           <dt x-translate>Total tax</dt>-->
<!--		           <dd>{{$fmt('taxTotal') | currency: record.currency.symbol}}</dd>-->
<!--		           <dt x-translate>Stamp</dt>-->
<!--		           <dd>{{record.inStamp}}</dd>-->
<!--		           <dt class="order-subtotal-total" x-translate>Total A.T.I.</dt>-->
<!--		           <dd class="order-subtotal-total">{{$fmt('inTaxTotal') | currency: record.currency.symbol}}</dd>-->
		         </dl>
        ]]></viewer>
      </field>
      <field name="$paymentVouchersOnInvoice" hidden="true" type="boolean"/>
      <field name="invoicePaymentList" showTitle="false" readonly="true" colSpan="12" css="order-subtotal">
        <viewer depends="typeSelect,statusSelect,id,paymentDate,amount,currency.symbol,$paymentVouchersOnInvoice,paymentMode,companyBankDetails,financialDiscountAmount,financialDiscountTaxAmount,applyFinancialDiscount,financialDiscountTotalAmount"><![CDATA[

                  <div class="form-item-container" style="flex-direction: column">
					<dl class="dl-horizontal" ng-class="{'hilite-danger-text': record.statusSelect == 2, 'hilite-info-text': record.statusSelect == 3}">
						<dt>
							<a href="#/ds/action-invoice-view-register-payment{{record.$paymentVouchersOnInvoice ? '-voucher':''}}/edit/{{record.id}}"><i class="fa fa-link" ng-class="{'font-black': record.statusSelect == 1, 'hilite-danger-text': record.statusSelect == 2, 'hilite-info-text': record.statusSelect == 3}"></i></a>
							<span>
								<font x-translate ng-if="(record.typeSelect == 1 || record.typeSelect == 2) && record.statusSelect != 2 && record.statusSelect != 3">Paid on</font>
								<font x-translate ng-if="(record.typeSelect == 1 || record.typeSelect == 2) && record.statusSelect == 2">Canceled payment on</font>
								<font x-translate ng-if="(record.typeSelect == 1 || record.typeSelect == 2) && record.statusSelect == 3">Pending payment</font>
								<font x-translate ng-if="record.typeSelect == 3">Ref. on</font>
								<font x-translate ng-if="record.typeSelect == 4">Inv. on</font>
								<font x-translate ng-if="record.typeSelect == 5">On</font>
								<font x-translate ng-if="record.typeSelect == 6">Imputed on</font>
								<font x-translate ng-if="record.typeSelect == 7">Exp. accounted on</font>
								<font x-translate ng-if="record.typeSelect == 8">Doubtful on</font>
								<font>
									 {{$fmt('paymentDate')}}
								</font>
							</span>
						</dt>
						<dd  ng-if="record.typeSelect == 8">
							{{$fmt('amount') | currency: record.currency.symbol}}
						</dd>
						<dd ng-if="record.typeSelect != 8">
							-{{$fmt('amount') | currency: record.currency.symbol}}
						</dd>
					</dl>
					<dl class="dl-horizontal" ng-class="{'hilite-danger-text': record.statusSelect == 2, 'hilite-info-text': record.statusSelect == 3}">
						<dt>
							<a href="#/ds/action-invoice-view-register-payment{{record.$paymentVouchersOnInvoice ? '-voucher':''}}/edit/{{record.id}}"><i ng-class="{'font-black': record.statusSelect == 1, 'hilite-danger-text': record.statusSelect == 2, 'hilite-info-text': record.statusSelect == 3}" ng-if="record.applyFinancialDiscount == true"></i></a>
							<font x-translate ng-if="(record.typeSelect == 1 || record.typeSelect == 2) && record.statusSelect != 2 && record.statusSelect != 3 && record.applyFinancialDiscount == true">Discounted on</font>
							<font x-translate ng-if="(record.typeSelect == 1 || record.typeSelect == 2) && record.statusSelect == 2 && record.applyFinancialDiscount == true">Canceled discount on</font>
							<font x-translate ng-if="(record.typeSelect == 1 || record.typeSelect == 2) && record.statusSelect == 3 && record.applyFinancialDiscount == true">Pending discount</font>
							<font x-translate ng-if="record.typeSelect == 3 && record.applyFinancialDiscount == true">Ref. on</font>
							<font x-translate ng-if="record.typeSelect == 4 && record.applyFinancialDiscount == true">Inv. on</font>
							<font x-translate ng-if="record.typeSelect == 5 && record.applyFinancialDiscount == true">On</font>
							<font x-translate ng-if="record.typeSelect == 6 && record.applyFinancialDiscount == true">Imputed on</font>
							<font x-translate ng-if="record.typeSelect == 7 && record.applyFinancialDiscount == true">Exp. accounted on</font>
							<font x-translate ng-if="record.applyFinancialDiscount == true">
								{{$fmt('paymentDate')}}
							</font>
						</dt>
						<dd ng-if="record.applyFinancialDiscount == true && record.financialDiscountTaxAmount > 0">
							-{{$fmt('financialDiscountTotalAmount')| currency: record.currency.symbol}}
						</dd>
						<dd ng-if="record.applyFinancialDiscount == true && record.financialDiscountTaxAmount == 0">
							-{{$fmt('financialDiscountAmount') | currency: record.currency.symbol}}
						</dd>
					</dl>
				</div>

        ]]></viewer>
        <editor/>
      </field>
      <field name="inTaxTotal" showTitle="false" showIf="statusSelect == 2 || statusSelect == 3" colSpan="12" css="order-subtotal">
        <viewer depends="amountRemaining,currency.symbol"><![CDATA[
		         <dl class="dl-horizontal">
		           <dt class="order-subtotal-total" x-translate>Amount due</dt>
		           <dd class="order-subtotal-total">{{$fmt('amountRemaining') | currency: record.currency.symbol}}</dd>
		         </dl>
        ]]></viewer>
      </field>
    </panel>
    <panel name="totalsCompanyCurrencyPanel" title="Totals company currency" showTitle="false" hideIf="partner == null || company == null || currency == null || company.currency.code == currency.code" itemSpan="6" sidebar="true">
      <field name="company.currency" hidden="true"/>
      <field name="company.currency.code" hidden="true"/>
      <field name="company.currency.symbol" hidden="true"/>
      <field name="companyInTaxTotalRemaining" hidden="true"/>
      <field name="companyInTaxTotal" showTitle="false" colSpan="12" css="order-subtotal">
        <viewer depends="companyExTaxTotal,company.currency.symbol,companyTaxTotal,companyInTaxTotal,companyInTaxTotalRemaining"><![CDATA[
		         <dl class="dl-horizontal">
		           <dt x-translate>Total W.T.</dt>
		           <dd>{{$fmt('companyExTaxTotal') | currency: record.company.currency.symbol}}</dd>
		           <dt x-translate>Total tax</dt>
		           <dd>{{$fmt('companyTaxTotal') | currency: record.company.currency.symbol}}</dd>
		           <dt class="order-subtotal-total" x-translate>Total A.T.I.</dt>
		           <dd class="order-subtotal-total">{{$fmt('companyInTaxTotal') | currency: record.company.currency.symbol}}</dd>
		         </dl>
		       ]]></viewer>
      </field>
      <field name="companyInTaxTotal" showTitle="false" showIf="statusSelect == 2 || statusSelect == 3" colSpan="12" css="order-subtotal">
        <viewer depends="companyInTaxTotalRemaining,company.currency.symbol"><![CDATA[
		         <dl class="dl-horizontal">
				   <dt class="order-subtotal-total" x-translate>Amount due</dt>
		           <dd class="order-subtotal-total">{{$fmt('companyInTaxTotalRemaining') | currency: record.company.currency.symbol}}</dd>
		         </dl>
        ]]></viewer>
      </field>
    </panel>
    <panel-stack name="otherDetailsPanel" hideIf="partner == null" sidebar="true">
      <panel name="referenceDocumentsPanel" title="Reference documents" itemSpan="6" canCollapse="true" collapseIf="true">
        <field name="internalReference"/>
        <field name="externalReference"/>
      </panel>
      <panel name="datesPanel" title="Dates" readonlyIf="statusSelect == 3" canCollapse="true" collapseIf="true">
        <field name="invoiceDate" readonlyIf="ventilatedByUser || ventilatedDateTime" onChange="action-invoice-group-payment-condition-onchange"/>
        <spacer/>
        <field name="dueDate" readonlyIf="!paymentCondition.isFree" onChange="action-invoice-method-estimated-payment-date"/>
        <field name="budgetDistributionGenerated" hidden="true"/>
        <field name="company.accountConfig.enableBudgetKey" hidden="true"/>
        <field name="purchaseOrder" hidden="true"/>
        <field name="$budgetExceedAlert" hidden="true" type="string"/>
        <field name="nextDueDate" showIf="invoiceTermList.length > 1"/>
        <field name="paymentCondition.isFree" hidden="true"/>
        <field name="paymentDelay" readonly="true" colSpan="12"/>
      </panel>
    </panel-stack>
    <panel-mail name="mailPanel">
      <mail-messages limit="4"/>
      <mail-followers/>
    </panel-mail>
  </form>
