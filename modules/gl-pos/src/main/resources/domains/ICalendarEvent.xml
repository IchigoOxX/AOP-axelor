<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_8.1.xsd">

  <module name="base" package="com.axelor.apps.base.db"/>

  <!-- Workaround for Hibernate 6 / Axelor 8 migration issue:
       Explicitly declare joined inheritance to allow subclasses like crm.Event to have their own tables. -->
  <entity name="ICalendarEvent" inheritance="joined" />

</domain-models>
