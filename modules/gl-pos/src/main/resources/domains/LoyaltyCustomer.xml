<?xml version="1.0" encoding="UTF-8"?> <domain-models xmlns="http://axelor.com/xml/ns/domain-models"   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"   xsi:schemaLocation="http://axelor.com/xml/ns/domain-models http://axelor.com/xml/ns/domain-models/domain-models_5.4.xsd">    <module name="pos" package="com.gl.apps.pos.db"/>

  <entity name="LoyaltyCustomer" lang="java" package="com.gl.apps.pos.db">     <many-to-one name="customer" ref="com.axelor.apps.base.db.Partner" title="Customer" required="true" unique="true"/>     <string name="loyaltyNumber" title="Loyalty Number" unique="true" required="true"/>     <string name="tier" title="Tier" default="BRONZE" help="Membership tier"/>          <decimal name="availablePoints" title="Available Points" precision="16" scale="2" default="0"/>     <decimal name="totalPointsEarned" title="Total Points Earned" precision="16" scale="2" default="0"/>     <decimal name="totalPointsRedeemed" title="Total Points Redeemed" precision="16" scale="2" default="0"/>          <integer name="totalTransactions" title="Total Transactions" default="0"/>     <decimal name="totalSpent" title="Total Spent" precision="16" scale="2" default="0"/>          <datetime name="enrollmentDate" title="Enrollment Date"/>     <datetime name="lastTransactionDate" title="Last Transaction Date"/>     <datetime name="expiryDate" title="Expiry Date" help="Set expiry for inactive members"/>          <boolean name="isActive" title="Active" default="true"/>     <string name="email" title="Email"/>     <string name="phone" title="Phone"/>          <string name="notes" title="Notes" large="true"/>     <one-to-many name="transactions" ref="com.gl.apps.pos.db.LoyaltyTransaction" title="Transactions" mappedBy="loyaltyCustomer"/>          <datetime name="createdOn" title="Created On"/>     <datetime name="updatedOn" title="Updated On"/>   </entity>  </domain-models>

