<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views http://axelor.com/xml/ns/object-views/object-views_6.1.xsd">

  <menuitem name="pos-root" title="Point of Sale (POS)" order="-199"
    icon="fa-shopping-basket" icon-background="#0288d1"/>

  <!-- Native POS Menus -->
  <menuitem name="pos-orders" parent="pos-root" order="10" title="Cashier Orders &amp; Invoices" icon="fa-shopping-cart" action="pos.sale.order.all" />
  <menuitem name="pos-shifts" parent="pos-root" order="20" title="Cashier Shifts &amp; Sessions" icon="fa-clock-o" action="pos.shift.all" />
  <menuitem name="pos-terminals" parent="pos-root" order="30" title="Cashier Terminals &amp; Stores" icon="fa-desktop" action="pos.store.all" />
  <menuitem name="pos-loyalty" parent="pos-root" order="40" title="Customer Loyalty Programs" icon="fa-star" action="pos.loyalty.customer.all" />
  <menuitem name="pos-root-products" parent="pos-root" order="50" title="POS Products &amp; Items" icon="fa-tags" action="pos.root.products"/>

  <!-- Action Views -->
  <action-view name="pos.sale.order.all" title="Cashier Orders &amp; Invoices" model="com.axelor.apps.sale.db.SaleOrder">
    <view type="grid" name="pos-sale-order-grid"/>
    <view type="form" name="pos-sale-order-form"/>
    <domain>self.company = :activeCompany AND self.store is not null</domain>
    <context name="activeCompany" expr="eval: __user__.activeCompany"/>
  </action-view>

  <action-view name="pos.shift.all" title="Cashier Shifts &amp; Sessions" model="com.axelor.pos.db.Shift">
    <view type="grid" name="shift-grid"/>
    <view type="form" name="shift-form"/>
  </action-view>

  <action-view name="pos.store.all" title="Cashier Terminals &amp; Stores" model="com.axelor.pos.db.Store">
    <view type="grid" name="store-grid"/>
    <view type="form" name="store-form"/>
    <domain>self.company = :activeCompany</domain>
    <context name="activeCompany" expr="eval: __user__.activeCompany"/>
  </action-view>

  <action-view name="pos.loyalty.customer.all" title="Customer Loyalty Programs" model="com.gl.apps.pos.db.LoyaltyCustomer">
    <view type="grid" name="loyalty-customer-grid"/>
    <view type="form" name="loyalty-customer-form"/>
  </action-view>

  <action-view name="pos.root.products" title="POS Products &amp; Items" model="com.axelor.apps.base.db.Product">
    <view type="cards" name="product-cards"/>
    <view type="grid" name="product-grid"/>
    <view type="form" name="product-form"/>
    <view-param name="search-filters" value="products-filters"/>
    <domain>self.isModel = false AND self.sellable = true AND self.isShippingCostsProduct = false
      AND self.dtype = 'Product'</domain>
    <context name="_activeCompany" expr="eval:__user__.activeCompany"/>
    <context name="_fromSale" expr="eval:true"/>
  </action-view>

  <menuitem name="pos-reports" parent="pos-root" order="60" title="Daily POS Sales Reports" icon="fa-bar-chart"/>
  
  <menuitem name="pos-reports-stock-details-by-product"
    parent="pos-reports" title="Stock Details by Product"
    action="stock.root.stock.details.by.product" order="1" icon="fa-info"/>

</object-views>
